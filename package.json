{
  "name": "markpad",
  "productName": "MarkPad",
  "description": "A fast, minimal Markdown workspace IDE built for writers and developers.",
  "version": "1.0.1",
  "author": {
    "name": "ZenithArcX",
    "email": "hello@markpad.app"
  },
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "icon": "node scripts/build-icon.mjs",
    "build:only": "tsc && vite build",
    "build": "npm run icon && tsc && vite build && electron-builder",
    "dist": "npm run icon && tsc && vite build && electron-builder --win",
    "dist:all": "npm run icon && tsc && vite build && electron-builder -wml",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@tailwindcss/typography": "^0.5.19",
    "@uiw/codemirror-theme-github": "^4.25.9",
    "@uiw/react-codemirror": "^4.25.9",
    "electron-store": "^8.2.0",
    "idb-keyval": "^6.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^4.11.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.1.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.4.38",
    "sharp": "^0.33.4",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}